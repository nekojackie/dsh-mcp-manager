{
  "name": "dsh-mcp-manager",
  "version": "0.3.2",
  "description": "Manage MCP servers from inside DeepSeek Harness: add, enable/disable, remove, reconnect, authorize with OAuth 2.1, renew tokens on a schedule whose policy is editable in the UI, renew after expiry, and browse every MCP tool with its description.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekojackie/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/nekojackie/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/nekojackie/dsh-mcp-manager/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/oauth.js",
    "docs/*.md",
    "fixtures/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "mcp-server",
    "oauth",
    "oauth2",
    "pkce",
    "tool-manager",
    "token-refresh"
  ],
  "author": "DeepSeek V4.1 Flash (generated)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
